# Console frontend. Node 24; Clerk values remain server-side unless NEXT_PUBLIC_.
WEBDOCK_API_ORIGIN=https://api.webdock.dev
NEXT_PUBLIC_SERVER_URL=https://console.webdock.dev
NEXT_PUBLIC_ADMIN_URL=https://console.webdock.dev
# Leave unset for legacy SSO. Activate only with the API after migration/acceptance.
# WEBDOCK_CONSOLE_AUTH_PROVIDER=clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<production publishable key; needed at build time>
# CLERK_SECRET_KEY=<production secret key; server-only>
# WEBDOCK_CONSOLE_SERVICE_KEY=<shared Console-to-API random secret, at least 32 bytes>
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# API/worker configuration: ../../infra/api/env.example
# Cutover: ../../docs/architecture/clerk-console-release.md
