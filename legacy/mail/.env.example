# Dedicated worker database role; never reuse the database owner in production.
DATABASE_URL=
MAIL_HOST_ID=primary
MAIL_DOCKER_SOCKET=unix:///var/run/docker.sock
MAIL_RUNTIME_NAMESPACE=webdock-mail
MAIL_HOSTNAME_SUFFIX=mail.webdock.dev
# Independent 32-byte base64 key. Keep stable or re-encrypt stored instance credentials.
MAIL_ENCRYPTION_KEY=

# Dedicated cluster gateway: no database or Stalwart administrator credential.
WEBDOCK_AUTH_ORIGIN=https://auth.webdock.dev
MAIL_GATEWAY_SECRET=
MAIL_BROWSER_ORIGINS=https://studio.webdock.dev

# Native send API + durable worker (bun run api); keep disabled until migration and private storage are ready.
WEBDOCK_NATIVE_MAIL_SENDING_ENABLED=false
MAIL_PAYLOAD_DIRECTORY=/data/payloads
# The public API is hosted by this persistent service, not a Vercel request body proxy.
# It uses MAIL_SEND_WORKER_SECRET for send control and MAIL_ENCRYPTION_KEY for private payloads.
# Worker control credential; must differ from the browser/JMAP gateway credential.
MAIL_SEND_WORKER_SECRET=
