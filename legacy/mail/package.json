{
  "name": "@webdock/mail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "worker": "bun src/worker.ts",
    "test": "bun test --isolate ./tests/*.test.ts",
    "test:integration": "bun ../../scripts/test-mail.mjs",
