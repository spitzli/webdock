    "api": "bun src/api/main.ts"
  },
  "dependencies": {
    "@webdock/mail-core": "*",
    "pg": "8.16.3",
    "nodemailer": "10.0.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5"
  }
}
