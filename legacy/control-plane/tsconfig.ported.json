{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src/modules/**/*.ts",
    "src/db/**/*.ts",
    "src/protocols/legacy-auth/**/*.ts",
    "tests/ported-auth/**/*.ts"
  ],
  "exclude": []
}
