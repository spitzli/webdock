# PUBLIC DEPLOYMENT SELECTORS ONLY. Private values belong in separate 0600 files.
WEBDOCK_API_IMAGE=registry.example.invalid/webdock-api@sha256:REVIEWED_IMAGE_DIGEST
WEBDOCK_INGRESS_NETWORK=existing-controlled-ingress
# .env.api.local (API only):
# NODE_ENV=production
# PORT=3130
# BIND_ADDRESS=0.0.0.0
# WEBDOCK_API_ORIGIN=https://api.webdock.dev
# BETTER_AUTH_URL=https://auth.webdock.dev
# WEBDOCK_STUDIO_ORIGIN=https://studio.webdock.dev
# WEBDOCK_CONSOLE_ORIGIN=https://console.webdock.dev
# Console is the browser origin; Studio remains the registered OAuth/MCP identity.
# WEBDOCK_API_DOMAINS=auth,registry,portal,cms,mail,hosting,databases,integrations,lifecycle,mcp
# WEBDOCK_INGRESS_SECRET=<existing shared ingress secret, at least 32 bytes>
# WEBDOCK_TRUSTED_PROXIES=<actual ingress peer CIDR, never 0.0.0.0/0>
# DATABASE_URL=<webdock_auth_runtime, verified TLS>
# AUTH_DATABASE_URL=<webdock_auth_bootstrap, verified TLS>
# DATABASE_WORKER_URL=<webdock_worker_runtime, verified TLS>
# REGISTRY_DATABASE_URL=<webdock_registry_runtime, verified TLS>
# DATABASE_POOL_MAX=2
# REGISTRY_POOL_MAX=2
# Platform PgBouncer: 2 per role, at most 10 server connections total.
# DATABASE_CA_CERT=<existing verified CA>
# DATABASE_RLS_SECRET=<existing context key, preserve exactly>
# BETTER_AUTH_SECRET=<existing key, preserve exactly>
# WEBDOCK_AUTH_ISSUER=https://auth.webdock.dev/api/auth
# WEBDOCK_SSO_APP_ORIGIN=https://studio.webdock.dev
# WEBDOCK_SSO_CLIENT_ID=<existing Studio client>
# WEBDOCK_STUDIO_CLIENT_ID=<same existing Studio client>
# WEBDOCK_SSO_CLIENT_SECRET=<existing client secret>
# WEBDOCK_SSO_COOKIE_SECRET=<existing cookie encryption key>
# WEBDOCK_MCP_RESOURCE=https://studio.webdock.dev/api/mcp
# VIEW_CACHE_URL=redis://default:<URL-encoded cache credential>@views:6379
# VIEW_CACHE_RELEASE=<immutable release identifier; Kubernetes supplies pod-template-hash>
# Preserve all configured provider/mail encryption keys and module credentials.
# Name-only inventory: docs/superpowers/plans/2026-10-13-api-rewrite/inventory.json
#
# .env.worker.local: ONLY worker profile plus required handler secrets.
# NODE_ENV=production
# DATABASE_WORKER_URL=<restricted worker URL>
# DATABASE_POOL_MAX=1
# DATABASE_CA_CERT=<existing CA>
# DATABASE_RLS_SECRET=<existing key>
# WEBDOCK_WORKER_DOMAINS=storage,mail
# WEBDOCK_BILLING_WORKER_ENVIRONMENTS=sandbox
# BETTER_AUTH_SECRET=<existing encryption root used by Billing>
# Preserve Mail handler keys if Mail worker ownership is transferred.
# NO DATABASE_URL / AUTH_DATABASE_URL / REGISTRY_DATABASE_URL / offline owner URL.
#
# Frontends: WEBDOCK_API_ORIGIN plus their public canonical origins only.
# Auth: BETTER_AUTH_URL, NEXT_PUBLIC_ADMIN_URL.
# Studio: NEXT_PUBLIC_SERVER_URL.
# No DB, SSO sealing or Better Auth secrets belong in either UI.
# Clerk Console alone requires its server-only Clerk key and delegation secret.

# .env.cache.local: DFLY_requirepass=<separate strong cache password>, mode 0600.

# Clerk activation (API, plus Console configuration in legacy/console/.env.example):
# WEBDOCK_CONSOLE_AUTH_PROVIDER=clerk
# CLERK_ISSUER=https://<exact-production-Clerk-host>
# CLERK_PUBLISHABLE_KEY=<production publishable key>
# CLERK_SECRET_KEY=<production secret key>
# WEBDOCK_CONSOLE_SERVICE_KEY=<same Console-to-API secret, at least 32 bytes>
# Keep WEBDOCK_CONSOLE_ORIGIN=https://console.webdock.dev exact, without wildcard.
# Workers revalidating Clerk viewer/job references need the same CLERK_ISSUER,
# CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY, WEBDOCK_CONSOLE_ORIGIN and
# WEBDOCK_CONSOLE_SERVICE_KEY. Never give workers the offline database owner URL.
# Retain Clerk verification config during rollback: linked legacy clients still
# require live provider membership checks. See docs/architecture/clerk-console-release.md.
