apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: auth-identity
  namespace: webdock-platform
spec:
  headers:
    customRequestHeaders:
      X-Forwarded-Host: auth.webdock.dev
      X-Forwarded-Proto: https
      X-Webdock-Client-IP: ''
      X-Vercel-Forwarded-For: ''
      Forwarded: ''
      X-Webdock-Ingress-Token: ${WEBDOCK_INGRESS_SECRET}
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: auth
  namespace: webdock-platform
spec:
  entryPoints:
  - websecure
  routes:
  - kind: Rule
    match: Host(`auth.webdock.dev`) && ((PathPrefix(`/api/`) && !Path(`/api/locale`))
      || PathPrefix(`/.well-known/`))
    priority: 100
    middlewares:
    - name: auth-identity
    services:
    - name: api
      port: 3130
  - kind: Rule
    match: Host(`auth.webdock.dev`) && !QueryRegexp(`x-vercel-set-bypass-cookie`,
      `.*`) && !QueryRegexp(`x-vercel-protection-bypass`, `.*`)
    priority: 10
    services:
    - name: ui-proxy
      port: 8080
  tls:
    certResolver: webdock
---
