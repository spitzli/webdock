apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: https-only
  namespace: webdock-platform
spec:
  redirectScheme:
    scheme: https
    permanent: true
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: http-redirect
  namespace: webdock-platform
spec:
  entryPoints:
  - web
  routes:
  - kind: Rule
    match: Host(`auth.webdock.dev`) || Host(`studio.webdock.dev`) || Host(`console.webdock.dev`) || Host(`api.webdock.dev`)
    middlewares:
    - name: https-only
    services:
    - name: api
      port: 3130
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: api-identity
  namespace: webdock-platform
spec:
  headers:
    customRequestHeaders:
      X-Forwarded-Host: api.webdock.dev
      X-Forwarded-Proto: https
      X-Webdock-Ingress-Token: ${WEBDOCK_INGRESS_SECRET}
      X-Webdock-Client-IP: ''
      X-Vercel-Forwarded-For: ''
      Forwarded: ''
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: api
  namespace: webdock-platform
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: 'true'
    traefik.ingress.kubernetes.io/router.tls.certresolver: webdock
    traefik.ingress.kubernetes.io/router.middlewares: webdock-platform-api-identity@kubernetescrd
spec:
  ingressClassName: traefik
  rules:
  - host: api.webdock.dev
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: api
            port:
              number: 3130
  tls:
  - hosts:
    - api.webdock.dev
