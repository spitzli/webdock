{
  "name": "@webdock/cms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev --port 3105",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint",
    "test": "bun --env-file=.env.local test --isolate ./tests/*.test.ts",
    "payload": "bun --env-file=.env.local ../../node_modules/payload/bin.js --disable-transpile",
    "cms:types": "bun run payload generate:types",
    "cms:migrate": "PAYLOAD_MIGRATING=true bun run payload migrate",
    "cms:seed": "bun --env-file=.env.local --env-file=.env.bootstrap scripts/seed.ts",
    "cms:sites": "bun --env-file=.env.local scripts/bootstrap-sites.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "4.0.0-canary.37",
    "@payloadcms/email-nodemailer": "4.0.0-canary.37",
    "@payloadcms/next": "4.0.0-canary.37",
    "@payloadcms/plugin-form-builder": "4.0.0-canary.37",
    "@payloadcms/plugin-multi-tenant": "4.0.0-canary.37",
    "@payloadcms/richtext-lexical": "4.0.0-canary.37",
    "@payloadcms/storage-vercel-blob": "4.0.0-canary.37",
    "@payloadcms/ui": "4.0.0-canary.37",
    "graphql": "16.14.2",
    "next": "16.3.8",
    "nodemailer": "10.0.13",
    "payload": "4.0.0-canary.37",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "@webdock/i18n": "*",
    "@webdock/database-runtime": "*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "type": "module"
}
