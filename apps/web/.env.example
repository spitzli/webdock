DATABASE_URL=postgresql://webdock_runtime:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://webdock_runtime:password@direct-host/database?sslmode=require
PAYLOAD_SECRET=replace-with-a-unique-instance-secret
OPERATOR_EMAIL=dominik@spitzli.dev
NEXT_PUBLIC_SERVER_URL=https://webdock.dev
SMTP_HOST=pro.eu.turbo-smtp.com
SMTP_PORT=465
SMTP_FROM=noreply@webdock.dev
SMTP_USER=
SMTP_PASS=

# Optional central SSO. Set all values together; keep local login during rollout.
WEBDOCK_AUTH_ISSUER=https://auth.webdock.dev/api/auth
WEBDOCK_SSO_CLIENT_ID=
WEBDOCK_SSO_CLIENT_SECRET=
WEBDOCK_SSO_COOKIE_SECRET=
WEBDOCK_SSO_APP_ORIGIN=https://webdock.dev
# Development only: true permits HTTP localhost/127.0.0.1 for both URLs.
WEBDOCK_SSO_ALLOW_LOCAL_HTTP=false

# Temporary legacy rollout: false still permits local passwords/JWTs outside central policy.
# Set true after operator MFA enrollment and customer migration to disable local login/recovery/JWTs.
WEBDOCK_SSO_ENFORCE=false
