DATABASE_URL=postgresql://webdock_admin_runtime:password@host/database?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://webdock_admin_runtime:password@direct-host/database?sslmode=verify-full
PAYLOAD_SECRET=replace-with-a-unique-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3120
OPERATOR_EMAIL=dominik@spitzli.dev
SMTP_HOST=pro.eu.turbo-smtp.com
SMTP_PORT=465
SMTP_FROM=noreply@webdock.dev
SMTP_USER=
SMTP_PASS=

# Central SSO. When configured, local password login, recovery, and Payload JWTs are disabled.
WEBDOCK_AUTH_ISSUER=https://auth.webdock.dev/api/auth
WEBDOCK_SSO_CLIENT_ID=
WEBDOCK_SSO_CLIENT_SECRET=
WEBDOCK_SSO_COOKIE_SECRET=
WEBDOCK_SSO_APP_ORIGIN=https://admin.webdock.dev
# Development only: true permits HTTP localhost/127.0.0.1 for both URLs.
WEBDOCK_SSO_ALLOW_LOCAL_HTTP=false
