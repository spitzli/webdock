# Studio is an HTTP-only Next.js frontend. Backend secrets belong in apps/api.
WEBDOCK_API_ORIGIN=https://api.webdock.dev
NEXT_PUBLIC_SERVER_URL=https://studio.webdock.dev
NEXT_PUBLIC_ADMIN_URL=https://studio.webdock.dev
# SSO cookies stay opaque here; API owns their credentials and validation.
