{
  "name": "@webdock/mail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "worker": "node src/worker.ts",
    "test": "node --test tests/*.test.ts",
    "test:integration": "node ../../scripts/test-mail.mjs",
    "test:database": "node --env-file=.env.test.local --test --test-concurrency=1 tests/database/*.test.ts",
    "check": "tsc --noEmit",
    "api": "node src/api/main.ts"
  },
  "dependencies": {
    "@webdock/mail-core": "*",
    "pg": "8.16.3",
    "nodemailer": "10.0.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5"
  }
}
