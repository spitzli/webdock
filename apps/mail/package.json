  "dependencies": { "@webdock/mail-core": "*", "pg": "8.16.3" },
  "devDependencies": {
    "@types/pg": "^8",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "nodemailer": "10.0.13",
    "typescript": "^5"
  }
}
