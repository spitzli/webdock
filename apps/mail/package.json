{
  "name": "@webdock/mail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "worker": "node src/worker.ts",
    "test": "node --test tests/*.test.ts",
