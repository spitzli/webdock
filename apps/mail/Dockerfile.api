FROM node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/mail/package.json apps/mail/package.json
COPY packages/mail-core/package.json packages/mail-core/package.json
RUN npm ci --omit=dev --ignore-scripts --workspace=@webdock/mail --include-workspace-root=false && npm cache clean --force

FROM node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json ./package.json
COPY apps/mail/package.json apps/mail/package.json
COPY apps/mail/src apps/mail/src
COPY packages/mail-core packages/mail-core
USER 65532:65532
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3139 MAIL_PAYLOAD_DIRECTORY=/data/payloads
EXPOSE 3139
CMD ["node", "apps/mail/src/api/main.ts"]
