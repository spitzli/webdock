[Unit]
Description=Webdock managed k3s hosting agent
After=network-online.target k3s.service
Wants=network-online.target
Requires=k3s.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/webdock-hosting-agent
ExecStart=/usr/bin/python3 /opt/webdock-hosting-agent/daemon.py --credentials /var/lib/webdock-hosting-agent/connection.json --interval 15
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=78
TimeoutStopSec=20
KillMode=control-group
UMask=0077
StateDirectory=webdock-hosting-agent
StateDirectoryMode=0700
RuntimeDirectory=webdock-hosting-agent
RuntimeDirectoryMode=0700
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=WEBDOCK_KUBECTL_CACHE_DIR=/var/lib/webdock-hosting-agent/kube-cache
Environment=WEBDOCK_EXECUTOR_LOCK=/run/webdock-hosting-agent/executor.lock
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
ReadWritePaths=/var/lib/webdock-hosting-agent /run/webdock-hosting-agent

[Install]
WantedBy=multi-user.target
