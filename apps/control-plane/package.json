{
  "name": "@webdock/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun --env-file=.env.test.local scripts/test.ts all",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && bun scripts/build.ts",
    "test:unit": "bun scripts/test.ts unit",
    "test:integration": "bun --env-file=.env.test.local scripts/test.ts integration",
    "test:ported": "bun --env-file=.env.test.local scripts/test.ts ported",
    "test:rls": "bun --env-file=.env.rls.test.local scripts/test.ts rls",
    "worker": "bun src/worker.ts",
    "migrate": "bun scripts/migrate.ts",
    "test:setup": "bun --no-env-file scripts/fixture.ts up",
    "test:teardown": "bun --no-env-file scripts/fixture.ts down",
    "test:setup:rls": "bun --no-env-file scripts/fixture-rls.ts",
    "build:core": "tsc --noEmit && bun scripts/build-core.ts",
    "start:core": "bun dist-core/core.js"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@vercel/blob": "2.3.1",
    "@webdock/database-contracts": "*",
    "@webdock/database-runtime": "*",
    "@webdock/hosting-contracts": "*",
    "@webdock/i18n": "*",
    "@webdock/mail-contracts": "*",
    "@webdock/mail-core": "*",
    "@webdock/oauth-session": "*",
    "@webdock/search": "*",
    "@webdock/snowflake": "*",
    "better-auth": "1.7.7",
    "better-call": "1.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "elysia": "1.4.30",
    "elysia-fsr": "0.1.0",
    "ipaddr.js": "2.3.0",
    "jose": "^6.1.0",
    "nodemailer": "10.0.13",
    "pg": "8.16.3",
    "zod": "4.6.5",
    "@webdock/page-builder": "*",
    "iron-session": "8.0.4",
    "@webdock/api-client": "*",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@webdock/module-sdk": "*",
    "@webdock/module-mail": "*",
    "@webdock/adapter-mail-turbosmtp": "*",
    "@webdock/core": "*",
    "@webdock/auth-better-auth": "*",
    "@webdock/module-hosting": "*",
    "@webdock/module-databases": "*",
    "@webdock/module-cms": "*",
    "@webdock/module-storage": "*",
    "@webdock/auth-clerk": "*",
    "@webdock/adapter-hosting-vercel": "*",
    "@webdock/adapter-database-postgres": "*",
    "@webdock/adapter-storage-vercel": "*",
    "@webdock/platform-db": "*",
    "@webdock/adapter-hosting-github": "*",
    "@clerk/backend": "3.24.0",
    "@webdock/plugin-sdk": "*",
    "@webdock/auth-configuration": "*",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/nodemailer": "^8",
    "@types/pg": "^8",
    "@types/react": "^19",
    "drizzle-kit": "1.0.0-rc.4",
    "prettier": "3.8.3",
    "typescript": "^5"
  },
  "exports": {
    "./modules/*": "./src/modules/*.ts"
  }
}
