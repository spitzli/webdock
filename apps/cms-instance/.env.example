# Independent instance identity; CMS_INSTANCE_ID is its Auth website binding ID.
CMS_INSTANCE_ID=
CMS_PROJECT_ID=
CMS_ORIGIN=https://cms.example.com
CMS_SITE_NAME=My site
PAYLOAD_SECRET=
CMS_BRIDGE_SECRET=
# Runtime receives only DML credentials. TLS verification is mandatory.
DATABASE_URL=postgresql://runtime:password@database.example.com/cms?sslmode=verify-full&sslrootcert=/var/run/webdock/services/binding/ca.crt
# Or supply the CA certificate as PEM via DATABASE_CA_CERT.
# DATABASE_CA_CERT=

# Migration job only; NEVER set these in the long-lived runtime.
# CMS_MIGRATING=true
# CMS_MIGRATION_DATABASE_URL=postgresql://migration:password@database.example.com/cms?sslmode=verify-full&sslrootcert=/var/run/webdock/services/binding/ca.crt
# CMS_BOOTSTRAP_SUBJECT=immutable-core-subject
# CMS_BOOTSTRAP_ROLE=admin

# Direct /cms SSO, in addition to the Console bridge.
# WEBDOCK_AUTH_ISSUER=https://auth.example.com/api/auth
# WEBDOCK_SSO_APP_ORIGIN=https://cms.example.com
# WEBDOCK_SSO_CLIENT_ID=
# WEBDOCK_SSO_CLIENT_SECRET=
# WEBDOCK_SSO_COOKIE_SECRET=
# WEBDOCK_SSO_ENFORCE=true
