# Load these through the service manager or bun --env-file.
HOST=127.0.0.1
PORT=3137
# The API owns this route but serves /api/databases/gateway on the Auth hostname.
WEBDOCK_AUTH_ORIGIN=https://auth.webdock.dev
WEBDOCK_DATABASE_GATEWAY_ORIGIN=https://database.webdock.dev
WEBDOCK_DATABASE_BROWSER_ORIGINS=https://studio.webdock.dev,https://console.webdock.dev
# Comma-separated exact private HTTPS origins, one isolated runtime per grant.
WEBDOCK_DATABASE_RUNTIME_ORIGINS=https://runtime-user-database.internal
WEBDOCK_DATABASE_GATEWAY_SECRET=
# Exact sourceCommit from vendor/tabularis-web-ui.json, also stamped at Rust build.
TABULARIS_EXPECTED_COMMIT=

# Opt in only after deploying the API migration, runtime image and database egress.
WEBDOCK_DATABASE_MANAGED_RUNTIMES=false
WEBDOCK_DATABASE_RUNTIME_CAPACITY=8
WEBDOCK_DATABASE_RUNTIME_DIRECTORY=/tmp
TABULARIS_EXECUTABLE=/usr/local/bin/tabularis
TABULARIS_WEB_ROOT=/opt/tabularis/web
