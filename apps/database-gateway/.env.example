# Node 24; load these through the service manager or node --env-file.
HOST=127.0.0.1
PORT=3137
WEBDOCK_AUTH_ORIGIN=https://auth.webdock.dev
WEBDOCK_DATABASE_GATEWAY_ORIGIN=https://database.webdock.dev
WEBDOCK_DATABASE_BROWSER_ORIGINS=https://studio.webdock.dev
# Comma-separated exact private HTTPS origins, one isolated runtime per grant.
WEBDOCK_DATABASE_RUNTIME_ORIGINS=https://runtime-user-database.internal
WEBDOCK_DATABASE_GATEWAY_SECRET=
# Exact sourceCommit from vendor/tabularis-web-ui.json, also stamped at Rust build.
TABULARIS_EXPECTED_COMMIT=
