{
  "name": "@webdock/database-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "start": "cargo run --manifest-path ../../Cargo.toml -p webdock-database-gateway",
    "test": "cargo test --manifest-path ../../Cargo.toml -p webdock-database-gateway",
    "test:compatibility": "bun test --isolate ./tests/*.test.ts",
    "check": "cargo check --manifest-path ../../Cargo.toml -p webdock-database-gateway",
    "build": "cargo build --manifest-path ../../Cargo.toml --release -p webdock-database-gateway"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/ws": "8.18.2",
    "typescript": "^5",
    "@webdock/database-contracts": "*",
    "ws": "8.22.0",
    "@webdock/integration-tabularis-web": "*"
  }
}
