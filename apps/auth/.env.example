DATABASE_URL=postgresql://webdock_auth_runtime:password@host/database?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://webdock_auth_runtime:password@direct-host/database?sslmode=verify-full
BETTER_AUTH_URL=https://auth.webdock.dev
BETTER_AUTH_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
NEXT_PUBLIC_ADMIN_URL=https://studio.webdock.dev
# Pin the registered first-party Studio OAuth client for server-side delegation.
WEBDOCK_STUDIO_CLIENT_ID=
WEBDOCK_STUDIO_ORIGIN=https://studio.webdock.dev
# Enable only after the Studio business UI is deployed.
STUDIO_UI_ENABLED=false
OPERATOR_EMAIL=dominik@spitzli.dev
SMTP_HOST=pro.eu.turbo-smtp.com
SMTP_PORT=465
SMTP_FROM=noreply@webdock.dev
SMTP_USER=
SMTP_PASS=
# After the native Mail migration and host setup; defaults off for existing deployments.
WEBDOCK_NATIVE_MAIL_ENABLED=false
# Existing platform-owned Webdock k3s cluster, not a Docker worker alias.
MAIL_MANAGED_CLUSTER_ID=
MAIL_STALWART_IMAGE=
MAIL_HOSTNAME_SUFFIX=mail.webdock.dev
# Independent 32-byte base64 key; preserve for existing instance credentials.
MAIL_ENCRYPTION_KEY=
