{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "managed-analytics-g3",
    "namespace": "webdock-plugins"
  },
  "spec": {
    "replicas": 1,
    "strategy": {
      "type": "Recreate"
    },
    "selector": {
      "matchLabels": {
        "webdock.dev/plugin": "managed-analytics",
        "webdock.dev/generation": "3"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "webdock.dev/plugin": "managed-analytics",
          "webdock.dev/generation": "3"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "runAsGroup": 1000,
          "fsGroup": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "plugin",
            "image": "ghcr.io/spitzli/webdock-extension-managed-analytics@sha256:515325955be99feb42a3ef5c92ebf3040c544e8f5b0cda7d03d15e02556d2cbf",
            "imagePullPolicy": "IfNotPresent",
            "ports": [
              {
                "name": "runtime",
                "containerPort": 3443
              },
              {
                "name": "ui",
                "containerPort": 3444
              }
            ],
            "envFrom": [
              {
                "secretRef": {
                  "name": "managed-analytics-g3-identity"
                }
              }
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "50m",
                "memory": "64Mi",
                "ephemeral-storage": "16Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "256Mi",
                "ephemeral-storage": "64Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "tls",
                "mountPath": "/runtime-tls",
                "readOnly": true
              },
              {
                "name": "tmp",
                "mountPath": "/tmp"
              }
            ],
            "readinessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": 3443,
                "scheme": "HTTPS"
              },
              "periodSeconds": 10,
              "timeoutSeconds": 3,
              "failureThreshold": 3
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": 3443,
                "scheme": "HTTPS"
              },
              "periodSeconds": 10,
              "timeoutSeconds": 3,
              "failureThreshold": 3
            },
            "startupProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": 3443,
                "scheme": "HTTPS"
              },
              "periodSeconds": 10,
              "timeoutSeconds": 3,
              "failureThreshold": 12
            }
          }
        ],
        "volumes": [
          {
            "name": "tls",
            "secret": {
              "secretName": "managed-analytics-g3-tls",
              "defaultMode": 288
            }
          },
          {
            "name": "tmp",
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "32Mi"
            }
          }
        ]
      }
    }
  }
}
