worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/null;
events { worker_connections 512; }
http {
 access_log off;
 client_body_temp_path /tmp/client_temp;
 proxy_temp_path /tmp/proxy_temp;
 fastcgi_temp_path /tmp/fastcgi_temp;
 uwsgi_temp_path /tmp/uwsgi_temp;
 scgi_temp_path /tmp/scgi_temp;
 resolver 10.43.0.10 valid=60s ipv6=off;
 client_max_body_size 4m;
 proxy_buffering off;
 proxy_request_buffering off;
 proxy_read_timeout 300s;
 proxy_http_version 1.1;
 proxy_ssl_server_name on;
 proxy_ssl_verify on;
 proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
 proxy_ssl_verify_depth 3;
 server { listen 8080 default_server; server_name _; location = /_webdock_proxy_health { return 200 'ok'; } location / { return 404; } }
 server {
  listen 8080;
  server_name auth.webdock.dev;
  location / {
   set $vercel_origin ${AUTH_UI_HOST};
   proxy_pass https://$vercel_origin;
   proxy_ssl_name $vercel_origin;
   proxy_set_header Host $vercel_origin;
   proxy_set_header X-Forwarded-Host auth.webdock.dev;
   proxy_set_header X-Forwarded-Proto https;
   proxy_set_header X-Vercel-Protection-Bypass ${AUTH_UI_BYPASS_SECRET};
   proxy_set_header X-Vercel-Set-Bypass-Cookie "";
   proxy_set_header X-Webdock-Ingress-Token "";
   proxy_set_header Connection "";
  }
 }
 server {
  listen 8080;
  server_name studio.webdock.dev;
  location / {
   set $vercel_origin ${STUDIO_UI_HOST};
   proxy_pass https://$vercel_origin;
   proxy_ssl_name $vercel_origin;
   proxy_set_header Host $vercel_origin;
   proxy_set_header X-Forwarded-Host studio.webdock.dev;
   proxy_set_header X-Forwarded-Proto https;
   proxy_set_header X-Vercel-Protection-Bypass ${STUDIO_UI_BYPASS_SECRET};
   proxy_set_header X-Vercel-Set-Bypass-Cookie "";
   proxy_set_header X-Webdock-Ingress-Token "";
   proxy_set_header Connection "";
  }
 }
}
