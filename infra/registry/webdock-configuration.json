  "admin_get_home_copy": {
    "eyebrow": {
      "enabled": true,
      "text": {
        "en": "Webdock \u00b7 Plugin Registry",
        "de": "Webdock \u00b7 Plugin-Registry"
      }
    },
    "features": {
      "enabled": false,
      "dropin": {
        "title": {
          "en": "A defined plugin contract",
          "de": "Ein klarer Plugin-Vertrag"
        },
        "body": {
          "en": "Declare runtime compatibility, capabilities and a digest-pinned container image in your manifest.",
          "de": "Deklariere Laufzeitkompatibilit\u00e4t, Berechtigungen und ein per Digest fixiertes Container-Image im Manifest."
        }
      },
      "providers": {
        "title": {
          "en": "Publish from GitHub",
          "de": "\u00dcber GitHub ver\u00f6ffentlichen"
        },
        "body": {
          "en": "Sign in with GitHub, connect your repository and submit your plugin for operator review.",
          "de": "Melde dich mit GitHub an, verbinde dein Repository und reiche dein Plugin zur Betreiberpr\u00fcfung ein."
        }
      },
      "release": {
        "title": {
          "en": "Versioned releases",
          "de": "Versionierte Releases"
        },
        "body": {
          "en": "Keep manifest versions, release tags and descriptor assets aligned. Webdock host integration is in development.",
          "de": "Halte Manifest-Version, Release-Tag und Deskriptor-Datei synchron. Die Webdock-Hostintegration ist in Entwicklung."
        }
      }
    }
  },
