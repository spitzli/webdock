{
  "admin_get_kind": {
    "kind": {
      "key": "extension",
      "label": "Extensions",
      "labelTranslations": {
        "de": "Erweiterungen"
      },
      "description": "Runtime extensions for Webdock projects with explicit capabilities and immutable OCI images.",
      "descriptionTranslations": {
        "de": "Laufzeiterweiterungen f\u00fcr Webdock-Projekte mit expliziten Berechtigungen und unver\u00e4nderlichen OCI-Images."
      },
      "publicPageEnabled": true,
      "publicPageCopy": {
        "hero": "Extend your Webdock projects.",
        "heroTranslations": {
          "de": "Erweitere deine Webdock-Projekte."
        },
        "intro": "Discover operator-reviewed extensions. The registry contract is available; host installation and runtime integration are still in development.",
        "introTranslations": {
          "de": "Entdecke vom Betreiber gepr\u00fcfte Erweiterungen. Der Registry-Vertrag steht bereit; Installation und Laufzeitintegration im Host sind noch in Entwicklung."
        }
      },
      "prosePre": "Documentation: https://docs.webdock.dev/developers/plugins\n\nUse `kind: extension` and the required `x-webdock` extension. Only JSON manifests are supported by the Webdock v1 contract.",
      "prosePost": "A registry schema check does not replace Webdock SDK validation, signed release verification, capability approval or host compatibility checks. The example uses a placeholder image digest and is not an installable release.",
      "customExample": {
        "json": "{\n  \"name\": \"project-notes\",\n  \"version\": \"1.0.0\",\n  \"kind\": \"extension\",\n  \"description\": \"Scoped project notes\",\n  \"x-webdock\": {\n    \"protocolVersion\": 1,\n    \"sdkVersion\": 1,\n    \"dataProtocolVersion\": 1,\n    \"coreVersion\": \">=0.1.0 <1.0.0\",\n    \"image\": \"registry.example.com/plugins/notes@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n    \"dependencies\": [],\n    \"capabilities\": [\n      \"project.read\",\n      \"plugin.data.read\",\n      \"plugin.data.write\"\n    ],\n    \"schemaVersion\": 1,\n    \"readableSchema\": {\n      \"min\": 1,\n      \"max\": 1\n    },\n    \"migrations\": [],\n    \"tables\": [],\n    \"services\": {\n      \"required\": [\n        {\n          \"name\": \"data\",\n          \"version\": 1\n        }\n      ],\n      \"optional\": []\n    },\n    \"configuration\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"additionalProperties\": false\n    },\n    \"actions\": [\n      {\n        \"name\": \"notes.read\",\n        \"intent\": \"read\",\n        \"capabilities\": [\n          \"plugin.data.read\"\n        ]\n      },\n      {\n        \"name\": \"notes.write\",\n        \"intent\": \"write\",\n        \"capabilities\": [\n          \"plugin.data.write\"\n        ]\n      }\n    ],\n    \"jobs\": [\n      {\n        \"name\": \"notes.maintenance\",\n        \"intervalSeconds\": 60,\n        \"capabilities\": [\n          \"plugin.data.write\"\n        ]\n      }\n    ],\n    \"navigation\": [],\n    \"slots\": [],\n    \"events\": [],\n    \"secrets\": [],\n    \"httpBindings\": []\n  }\n}"
      }
    }
  },
