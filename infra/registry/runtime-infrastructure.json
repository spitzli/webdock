{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "registry-postgres",
        "namespace": "wd-104618288083894272"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "webdock.dev/app-id": "104651089088876544"
          }
        },
        "policyTypes": [
          "Egress"
        ],
        "egress": [
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "wd-db-103217546630533120"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "cnpg.io/cluster": "postgres",
                    "cnpg.io/podRole": "instance"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 5432
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "cert-manager.io/v1",
      "kind": "Issuer",
      "metadata": {
        "name": "webdock-acme",
        "namespace": "wd-104618288083894272"
      },
      "spec": {
        "acme": {
          "email": "dominik@spitzli.dev",
          "privateKeySecretRef": {
            "name": "webdock-acme-account"
          },
          "server": "https://acme-v02.api.letsencrypt.org/directory",
          "solvers": [
            {
              "http01": {
                "ingress": {
                  "ingressClassName": "traefik",
                  "serviceType": "ClusterIP",
                  "podTemplate": {
                    "metadata": {
                      "labels": {
                        "security.webdock.dev/ingress": "true"
                      }
                    },
                    "spec": {
                      "resources": {
                        "limits": {
                          "cpu": "200m",
                          "memory": "64Mi",
                          "ephemeral-storage": "64Mi"
                        },
                        "requests": {
                          "cpu": "25m",
                          "memory": "32Mi",
                          "ephemeral-storage": "8Mi"
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "registry",
        "namespace": "wd-104618288083894272",
        "annotations": {
          "cert-manager.io/issuer": "webdock-acme",
          "traefik.ingress.kubernetes.io/router.entrypoints": "websecure"
        }
      },
      "spec": {
        "ingressClassName": "traefik",
        "tls": [
          {
            "hosts": [
              "registry.webdock.dev"
            ],
            "secretName": "registry-tls"
          }
        ],
        "rules": [
          {
            "host": "registry.webdock.dev",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "app-104651089088876544",
                      "port": {
                        "number": 3000
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "apiVersion": "traefik.io/v1alpha1",
      "kind": "Middleware",
      "metadata": {
        "name": "registry-https",
        "namespace": "wd-104618288083894272"
      },
      "spec": {
        "redirectScheme": {
          "scheme": "https",
          "permanent": true
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "registry-http",
        "namespace": "wd-104618288083894272",
        "annotations": {
          "traefik.ingress.kubernetes.io/router.entrypoints": "web",
          "traefik.ingress.kubernetes.io/router.middlewares": "wd-104618288083894272-registry-https@kubernetescrd"
        }
      },
      "spec": {
        "ingressClassName": "traefik",
        "rules": [
          {
            "host": "registry.webdock.dev",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "app-104651089088876544",
                      "port": {
                        "number": 3000
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
