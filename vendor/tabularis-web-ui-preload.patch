--- /dev/null
+++ b/packages/web-ui/src/utils/preloadWorkspace.ts
@@ -0,0 +1,6 @@
+import { ensureMonaco } from "./monaco";
+
+/** Download the workspace and local editor while the host negotiates access. */
+export async function preloadTabularisWorkspace(): Promise<void> {
+  await Promise.all([import("../embed/WorkspaceRuntime"), ensureMonaco()]);
+}
diff --git a/packages/web-ui/tests/embed/preload.test.tsx b/packages/web-ui/tests/embed/preload.test.tsx
new file mode 100644
index 00000000..9168cd29
--- /dev/null
+++ b/packages/web-ui/tests/embed/preload.test.tsx
@@ -0,0 +1,45 @@
+import { render, screen } from "@testing-library/react";
+import { describe, expect, it, vi } from "vitest";
+import type { TabularisClient } from "../../src/api/client";
+
+// Keep chunk downloads pending independently to catch a serial loading waterfall.
+const chunks = vi.hoisted(() => {
+  let runtimeReady!: () => void, editorReady!: () => void;
+  return {
+    runtime: new Promise<void>(resolve => { runtimeReady = resolve; }),
+    editor: new Promise<void>(resolve => { editorReady = resolve; }),
+    runtimeReady: () => runtimeReady(), editorReady: () => editorReady(),
+    runtimeStarted: false, editorStarted: false,
+  };
+});
+vi.mock("../../src/embed/WorkspaceRuntime", async () => {
+  chunks.runtimeStarted = true;
+  await chunks.runtime;
+  return { WorkspaceRuntime: () => <p>Ready workspace</p> };
+});
+vi.mock("../../src/monacoLoader", async () => {
+  chunks.editorStarted = true;
+  await chunks.editor;
+  return { monaco: {} };
+});
+
+describe("workspace preload", () => {
+  it("loads runtime and editor concurrently without mounting the workspace or contacting a server", async () => {
+    const api = await import("../../src/embed/index");
+    expect(api.preloadTabularisWorkspace).toBeTypeOf("function");
+    const fetch = vi.fn(); vi.stubGlobal("fetch", fetch);
+    try {
+      const loading = api.preloadTabularisWorkspace();
+      await vi.waitFor(() => {
+        expect(chunks.runtimeStarted).toBe(true);
+        expect(chunks.editorStarted).toBe(true);
+      });
+      expect(screen.queryByText("Ready workspace")).not.toBeInTheDocument();
+      expect(fetch).not.toHaveBeenCalled();
+      chunks.runtimeReady(); chunks.editorReady(); await loading;
+      await api.preloadTabularisWorkspace();
+      render(<api.TabularisWorkspace scopeId="session" connectionId="db" client={{} as TabularisClient} />);
+      expect(await screen.findByText("Ready workspace")).toBeInTheDocument();
+    } finally { chunks.runtimeReady(); chunks.editorReady(); vi.unstubAllGlobals(); }
+  });
+});
diff --git a/packages/web-ui/tests/embed/preloadRetry.test.ts b/packages/web-ui/tests/embed/preloadRetry.test.ts
