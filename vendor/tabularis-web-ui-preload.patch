index 00000000..3b03d708
--- /dev/null
+++ b/packages/web-ui/tests/embed/preloadRetry.test.ts
@@ -0,0 +1,13 @@
+import { describe, expect, it, vi } from "vitest";
+
+vi.mock("../../src/embed/WorkspaceRuntime", () => ({ WorkspaceRuntime: () => null }));
+
+describe("workspace preload retry", () => {
+  it("reports a failed editor download and allows a later attempt", async () => {
+    vi.doMock("../../src/monacoLoader", () => { throw Error("Editor chunk unavailable"); });
+    const { preloadTabularisWorkspace } = await import("../../src/utils/preloadWorkspace");
+    await expect(preloadTabularisWorkspace()).rejects.toThrow();
+    vi.doMock("../../src/monacoLoader", () => ({ monaco: {} }));
+    await expect(preloadTabularisWorkspace()).resolves.toBeUndefined();
+  });
+});
diff --git a/packages/web-ui/tests/embed/preloadSafety.test.ts b/packages/web-ui/tests/embed/preloadSafety.test.ts
new file mode 100644
index 00000000..d1bc75cf
--- /dev/null
+++ b/packages/web-ui/tests/embed/preloadSafety.test.ts
@@ -0,0 +1,19 @@
+import { describe, expect, it, vi } from "vitest";
+
+// Monaco depends on browser workers; the real workspace module is loaded here.
+vi.unmock("lucide-react");
+vi.mock("../../src/monacoLoader", () => ({ monaco: {} }));
+
+describe("workspace preload safety", () => {
+  it("evaluates the workspace without issuing RPCs or changing host routing", async () => {
+    const fetch = vi.fn(); vi.stubGlobal("fetch", fetch);
+    const location = window.location.href;
+    try {
+      const { preloadTabularisWorkspace } = await import("../../src/utils/preloadWorkspace");
+      await preloadTabularisWorkspace();
+      expect(fetch).not.toHaveBeenCalled();
+      expect(document.querySelector(".tabularis-workspace")).toBeNull();
+      expect(window.location.href).toBe(location);
+    } finally { vi.unstubAllGlobals(); }
+  });
+});
