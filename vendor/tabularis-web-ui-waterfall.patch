diff --git a/packages/web-ui/tests/embed/preloadMount.test.tsx b/packages/web-ui/tests/embed/preloadMount.test.tsx
new file mode 100644
index 00000000..2c4ad917
--- /dev/null
+++ b/packages/web-ui/tests/embed/preloadMount.test.tsx
@@ -0,0 +1,32 @@
+import { act, fireEvent, render, screen } from "@testing-library/react";
+import { useState } from "react";
+import { describe, expect, it, vi } from "vitest";
+import type { TabularisClient } from "../../src/api/client";
+import { TabularisWorkspace } from "../../src/embed/TabularisWorkspace";
+import { preloadTabularisWorkspace } from "../../src/utils/preloadWorkspace";
+
+const chunk = vi.hoisted(() => {
+  let ready!: () => void;
+  return { pending: new Promise<void>(resolve => { ready = resolve; }), ready: () => ready() };
+});
+vi.mock("../../src/monacoLoader", () => ({ monaco: {} }));
+vi.mock("../../src/embed/WorkspaceRuntime", async () => {
+  await chunk.pending;
+  return { WorkspaceRuntime: function Draft() {
+    const [draft, setDraft] = useState("");
+    return <input aria-label="SQL draft" value={draft} onChange={event => setDraft(event.target.value)} />;
+  } };
+});
+
+describe("workspace preload during mount", () => {
+  it("keeps the lazy fallback and preserves drafts after a late preload completes", async () => {
+    const loading = preloadTabularisWorkspace();
+    const props = { scopeId: "session", connectionId: "db", client: {} as TabularisClient };
+    const { rerender } = render(<TabularisWorkspace {...props} theme="light" />);
+    expect(screen.getByRole("status")).toHaveTextContent("Loading database");
+    await act(async () => { chunk.ready(); await loading; });
+    fireEvent.change(await screen.findByLabelText("SQL draft"), { target: { value: "select 1" } });
+    rerender(<TabularisWorkspace {...props} theme="dark" />);
+    expect(screen.getByLabelText("SQL draft")).toHaveValue("select 1");
+  });
+});
