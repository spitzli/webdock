@@ -1,6 +1,12 @@
 import { ensureMonaco } from "./monaco";
 
+let runtime: typeof import("../embed/WorkspaceRuntime")["WorkspaceRuntime"] | undefined;
+export const getPreloadedWorkspaceRuntime = () => runtime;
+
