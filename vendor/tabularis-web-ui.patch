@@ -0,0 +1,26 @@
+export interface GridMutation {
+  run: () => Promise<unknown>;
+  confirm: () => void;
+}
+
+export class GridCommitError extends Error {
+  readonly completed: number;
+  readonly requiresReview = true;
+  constructor(cause: unknown, completed: number) {
+    super(cause instanceof Error ? cause.message : String(cause), { cause });
+    this.name = "GridCommitError";
+    this.completed = completed;
+  }
+}
+
+/** A lost response may follow a committed write. Never replay this batch automatically. */
+export async function commitGridMutations(operations: readonly GridMutation[]): Promise<void> {
+  let completed = 0;
+  try {
+    for (const operation of operations) {
+      await operation.run();
+      operation.confirm();
+      completed++;
+    }
+  } catch (cause) { throw new GridCommitError(cause, completed); }
+}
