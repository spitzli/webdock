diff --git a/packages/web-ui/scripts/checkLibrary.mjs b/packages/web-ui/scripts/checkLibrary.mjs
new file mode 100644
index 00000000..be312f51
--- /dev/null
+++ b/packages/web-ui/scripts/checkLibrary.mjs
@@ -0,0 +1,16 @@
+import assert from "node:assert/strict";
+import { readFile, readdir, access } from "node:fs/promises";
+const manifest = JSON.parse(await readFile(new URL("../package.json", import.meta.url), "utf8"));
+for (const entry of [manifest.exports["."].import, manifest.exports["."].types, manifest.exports["./workspace.css"]]) {
+  await access(new URL("../"+entry, import.meta.url));
+}
+const root = new URL("../lib/", import.meta.url);
+const css = await readFile(new URL("workspace.css", root), "utf8");
+assert.ok(css.includes("@scope (.tabularis-workspace)"), "Library stylesheet must be scoped after CSS emission");
+assert.ok(!css.includes("../fonts/"), "Library must include its fonts");
+for (const name of await readdir(root)) {
+  if (!name.endsWith(".js")) continue;
+  const source = await readFile(new URL(name, root), "utf8");
+  assert.ok(!/["']\/assets\//.test(source), `${name}: worker/assets must be relative to the library`);
+}
+console.log("Library exports, scoped styles, fonts and relative assets verified.");
diff --git a/packages/web-ui/scripts/scopeWorkspaceCss.ts b/packages/web-ui/scripts/scopeWorkspaceCss.ts
new file mode 100644
index 00000000..00460409
--- /dev/null
+++ b/packages/web-ui/scripts/scopeWorkspaceCss.ts
@@ -0,0 +1,22 @@
+import postcss from "postcss";
+
+/** Library CSS must never reset the embedding application's document. */
+export function scopeWorkspaceCss(source: string): string {
+  const css = postcss.parse(source);
+  css.walkAtRules("layer", rule => {
+    if (rule.nodes) rule.replaceWith(...rule.nodes);
+    else rule.remove();
+  });
+  css.walkRules(rule => {
+    rule.selectors = rule.selectors.map(selector => /^(html|body|:root|:host|#root)$/.test(selector.trim()) ? ":scope" : selector);
+  });
+  const scope = postcss.atRule({ name: "scope", params: "(.tabularis-workspace)" });
+  const output = postcss.root();
+  for (const node of [...css.nodes]) {
+    if (node.type === "atrule" && ["font-face", "property", "charset"].includes(node.name)) output.append(node);
+    else scope.append(node);
+  }
+  output.append(scope);
+  output.append(postcss.parse(".tabularis-workspace { height: 100%; min-height: 32rem; min-width: 0; isolation: isolate; font-size: 14px; overflow: hidden; }"));
+  return output.toString();
+}
