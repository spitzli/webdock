+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { defineConfig } from "vite";
+import react from "@vitejs/plugin-react";
+import { scopeWorkspaceCss } from "./scripts/scopeWorkspaceCss";
+
+const root = fileURLToPath(new URL(".", import.meta.url));
+
+export default defineConfig({
+  base: "./",
+  plugins: [react(), {
+    name: "scope-tabularis-library-css",
+    enforce: "post",
+    generateBundle: { order: "post", handler(_options, bundle) {
+      for (const item of Object.values(bundle)) {
+        if (item.type !== "asset" || !item.fileName.endsWith(".css")) continue;
+        const css = String(item.source).replace(/(?:\.\.\/|\/)fonts\/([a-z-]+\.woff2)/g, (_match, name: string) =>
+          `data:font/woff2;base64,${readFileSync(new URL(`./public/fonts/${name}`, import.meta.url)).toString("base64")}`);
+        item.source = scopeWorkspaceCss(css);
+      }
+    } },
+  }],
+  css: { postcss: root },
+  define: { global: "globalThis", "process.env": {} },
+  build: {
+    outDir: "lib", copyPublicDir: false, chunkSizeWarningLimit: 8000,
+    lib: { entry: fileURLToPath(new URL("./src/embed/index.ts", import.meta.url)), formats: ["es"], fileName: "index", cssFileName: "workspace" },
+    rollupOptions: {
+      external: id => /^(react|react-dom)(\/|$)/.test(id),
+      output: {
+        banner: chunk => chunk.isEntry ? '"use client";' : "",
+        onlyExplicitManualChunks: true,
+        manualChunks: id => id.includes("/lucide-react/") ? "icons" : undefined,
+      },
+    },
+  },
+});
