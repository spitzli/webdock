@@ -0,0 +1,27 @@
+import { describe, expect, it } from "vitest";
+import { commitGridMutations, GridCommitError } from "../../src/utils/gridMutations";
+
+describe("grid mutation submission", () => {
+  it("submits large batches with bounded concurrency and acknowledges each successful row", async () => {
+    let active = 0, maximum = 0; const confirmed: number[] = [];
+    const operations = Array.from({ length: 40 }, (_, id) => ({
+      run: async () => { active++; maximum = Math.max(active, maximum); await Promise.resolve(); active--; },
+      confirm: () => { confirmed.push(id); },
+    }));
+    await commitGridMutations(operations);
+    expect(maximum).toBe(1); expect(confirmed).toHaveLength(40);
+  });
+  it("keeps only unconfirmed rows pending and stops after an ambiguous committed insert", async () => {
+    const rows: number[] = [], pending = new Set([1, 2, 3]);
+    const operations = [...pending].map(id => ({
+      run: async () => { rows.push(id); if (id === 2) throw new Error("Response lost after commit"); },
+      confirm: () => { pending.delete(id); },
+    }));
+    let failure: unknown;
+    try { await commitGridMutations(operations); } catch (error) { failure = error; }
+    expect(failure).toBeInstanceOf(GridCommitError);
+    expect((failure as GridCommitError).completed).toBe(1);
+    expect((failure as GridCommitError).requiresReview).toBe(true);
+    expect(rows).toEqual([1, 2]); expect([...pending]).toEqual([2, 3]);
+  });
+});
