+import { act, renderHook } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+import { applyThemeToCSS } from "../../src/themes/themeUtils";
+import { themeRegistry } from "../../src/themes/themeRegistry";
+import { UiStateStore, UI_STATE_KEYS, UI_STATE_CACHE_KEY } from "../../src/utils/uiStateStore";
+import { UiStateContext } from "../../src/contexts/UiStateContext";
+import { useUiState } from "../../src/hooks/useUiState";
+
+describe("embedded workspace isolation", () => {
+  it("applies a theme to its own element without modifying the host or boot cache", () => {
+    const root = document.createElement("div");
+    const before = document.documentElement.getAttribute("style");
+    const storage = { ...localStorage };
+    applyThemeToCSS(themeRegistry.getPreset("tabularis-dark")!, root);
+    expect(root.style.getPropertyValue("--bg-base")).not.toBe("");
+    expect(document.documentElement.getAttribute("style")).toBe(before);
+    expect({ ...localStorage }).toEqual(storage);
+  });
+
+  it("does not hydrate a workspace from another user's browser cache", () => {
+    localStorage.setItem(UI_STATE_CACHE_KEY, JSON.stringify({ tabularis_sidebar_width: 999 }));
+    const store = new UiStateStore(undefined, null);
+    expect(store.get("tabularis_sidebar_width", 280)).toBe(280);
+    store.set("tabularis_sidebar_width", 320);
+    expect(localStorage.getItem(UI_STATE_CACHE_KEY)).toContain("999");
+  });
+
+  it("uses the current provider's store and keeps sibling workspaces independent", () => {
+    const first = new UiStateStore(undefined, null);
+    const second = new UiStateStore(undefined, null);
+    const a = renderHook(() => useUiState(UI_STATE_KEYS.sidebarWidth, 280), {
+      wrapper: ({ children }) => <UiStateContext.Provider value={first}>{children}</UiStateContext.Provider>,
+    });
+    const b = renderHook(() => useUiState(UI_STATE_KEYS.sidebarWidth, 280), {
+      wrapper: ({ children }) => <UiStateContext.Provider value={second}>{children}</UiStateContext.Provider>,
+    });
+    act(() => a.result.current[1](360));
+    expect(a.result.current[0]).toBe(360);
+    expect(b.result.current[0]).toBe(280);
+  });
+});
