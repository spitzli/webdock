+"use client";
+
+import { lazy, Suspense, useState } from "react";
+import { MemoryRouter } from "react-router-dom";
+import { buildEditorRoute } from "../routing";
+import type { TabularisWorkspaceProps } from "./types";
+
+const Runtime = lazy(() => import("./WorkspaceRuntime").then(module => ({ default: module.WorkspaceRuntime })));
+
+/** Host routing and authentication remain outside the embedded workbench. */
+export function TabularisWorkspace(props: TabularisWorkspaceProps) {
+  const [root, setRoot] = useState<HTMLDivElement | null>(null);
+  return <div ref={setRoot} className={`tabularis-workspace ${props.className ?? ""}`}>
+    {root && <MemoryRouter key={JSON.stringify([props.scopeId, props.connectionId])}
+      initialEntries={[buildEditorRoute(props.connectionId)]}>
+      <Suspense fallback={<p role="status">{props.locale === "de" ? "Datenbank wird geladen…" : "Loading database…"}</p>}>
+        <Runtime {...props} root={root} />
+      </Suspense>
+    </MemoryRouter>}
+  </div>;
+}
