@@ -0,0 +1,18 @@
+import { BrowserPlatformCapabilities } from "../platform/browserCapabilities";
+import type { PlatformCapabilities, PlatformCapabilityName, PlatformCapabilityAvailability } from "../platform/capabilities";
+import type { TabularisClient } from "../api/client";
+
+export function createEmbeddedPlatform(client: TabularisClient): PlatformCapabilities {
+  const browser = new BrowserPlatformCapabilities(client);
+  const blocked: PlatformCapabilityAvailability = { supported: false, adaptation: "unsupported", reason: "Secondary windows are unavailable in this embedded workspace." };
+  const negotiation = { ...browser.negotiation, capabilities: { ...browser.negotiation.capabilities, openRoute: blocked, closeRoute: blocked } };
+  return new Proxy(browser, {
+    get(target, name) {
+      if (name === "negotiation") return negotiation;
+      if (name === "supports") return (capability: PlatformCapabilityName) => negotiation.capabilities[capability].supported;
+      if (name === "openRoute" || name === "openConnectionRoute" || name === "closeRoute") return async () => { throw new Error(blocked.reason); };
+      const value = Reflect.get(target, name);
+      return typeof value === "function" ? value.bind(target) : value;
+    },
+  });
+}
