+import { createEmbeddedPlatform } from "./platform";
+import { WorkspaceRootContext } from "../contexts/WorkspaceRootContext";
+import { ToastProvider } from "../contexts/ToastProvider";
+import { AlertProvider } from "../contexts/AlertProvider";
+import { DatabaseProvider } from "../contexts/DatabaseProvider";
+import { SavedQueriesProvider } from "../contexts/SavedQueriesProvider";
+import { QueryHistoryProvider } from "../contexts/QueryHistoryProvider";
+import { EditorProvider } from "../contexts/EditorProvider";
+import { ProductionGuardProvider } from "../contexts/ProductionGuardContext";
+import { KeybindingsProvider } from "../contexts/KeybindingsProvider";
+import { ConnectionLayoutProvider } from "../contexts/ConnectionLayoutProvider";
+import { RightSidebarProvider } from "../contexts/RightSidebarProvider";
+import { CommandPaletteProvider } from "../contexts/CommandPaletteProvider";
+import { PluginSlotContext } from "../contexts/PluginSlotContext";
+import { PluginModalProvider } from "../contexts/PluginModalProvider";
+import { BrowserPlatformDialogs } from "../components/modals/BrowserPlatformDialogs";
+import { WorkspaceAppearance } from "./WorkspaceAppearance";
+import { WorkspaceLayout } from "./WorkspaceLayout";
+import { ConnectionEditorRoute } from "../pages/ConnectionEditorRoute";
+import type { WorkspaceRuntimeProps } from "./types";
+import { BROWSER_ROUTES } from "../routing";
+
+const noExtensions = {
+  contributions: [], register: () => () => {}, registerAll: () => () => {}, getSlotContributions: () => [],
+};
+
+export function WorkspaceRuntime(props: WorkspaceRuntimeProps) {
+  const [store] = useState(() => new UiStateStore(undefined, null));
+  const platform = useMemo(() => createEmbeddedPlatform(props.client), [props.client]);
+  // The surrounding session owns the transport; every provider releases its subscriptions on unmount.
+  useEffect(() => () => { store.reset(); }, [store]);
+  return <WorkspaceRootContext.Provider value={props.root}><TabularisClientProvider client={props.client}>
+    <UiStateProvider store={store}><PlatformCapabilitiesProvider capabilities={platform}>
+      <WorkspaceAppearance {...props}><ToastProvider><AlertProvider>
+        <DatabaseProvider><SavedQueriesProvider><QueryHistoryProvider><EditorProvider>
+          <ProductionGuardProvider><KeybindingsProvider><PluginSlotContext.Provider value={noExtensions}>
+            <PluginModalProvider><ConnectionLayoutProvider><RightSidebarProvider>
+              <BrowserPlatformDialogs />
+              <CommandPaletteProvider><WorkspaceLayout>
+                <Routes><Route path={BROWSER_ROUTES.connectionEditor} element={<ConnectionEditorRoute />} />
+                  <Route path="*" element={<p role="alert">{props.locale === "de" ? "Datenbank nicht verfügbar. Bitte erneut über die Anwendung öffnen." : "Database unavailable. Reopen it from the host application."}</p>} />
+                </Routes>
+              </WorkspaceLayout></CommandPaletteProvider>
+            </RightSidebarProvider></ConnectionLayoutProvider></PluginModalProvider>
+          </PluginSlotContext.Provider></KeybindingsProvider></ProductionGuardProvider>
+        </EditorProvider></QueryHistoryProvider></SavedQueriesProvider></DatabaseProvider>
+      </AlertProvider></ToastProvider></WorkspaceAppearance>
+    </PlatformCapabilitiesProvider></UiStateProvider>
+  </TabularisClientProvider></WorkspaceRootContext.Provider>;
+}
