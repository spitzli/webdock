+import { fireEvent, render, screen } from "@testing-library/react";
+import { useState } from "react";
+import { useLocation, useNavigate } from "react-router-dom";
+import { describe, expect, it, vi } from "vitest";
+import type { TabularisClient } from "../../src/api/client";
+import { TabularisWorkspace } from "../../src/embed/TabularisWorkspace";
+
+vi.mock("../../src/embed/WorkspaceRuntime", () => ({
+  WorkspaceRuntime: function Probe() {
+    const location = useLocation(), navigate = useNavigate();
+    const [draft, setDraft] = useState("");
+    return <><input aria-label="SQL draft" value={draft} onChange={e => setDraft(e.target.value)} />
+      <button onClick={() => navigate("/editor/internal")}>Navigate</button><output>{location.pathname}</output></>;
+  },
+}));
+
+describe("TabularisWorkspace", () => {
+  it("owns internal routing while leaving the host URL untouched", async () => {
+    const before = location.href;
+    render(<TabularisWorkspace scopeId="one" connectionId="db" client={{} as TabularisClient} />);
+    fireEvent.click(await screen.findByText("Navigate"));
+    expect(screen.getByText("/editor/internal")).toBeInTheDocument();
+    expect(location.href).toBe(before);
+  });
+
+  it("preserves drafts on appearance changes and resets them on authorization scope changes", async () => {
+    const client = {} as TabularisClient;
+    const { rerender } = render(<TabularisWorkspace scopeId="one" connectionId="db" client={client} theme="light" />);
+    fireEvent.change(await screen.findByLabelText("SQL draft"), { target: { value: "select 1" } });
+    rerender(<TabularisWorkspace scopeId="one" connectionId="db" client={client} theme="dark" locale="de" />);
+    expect(screen.getByLabelText("SQL draft")).toHaveValue("select 1");
+    rerender(<TabularisWorkspace scopeId="two" connectionId="db" client={client} />);
+    expect(await screen.findByLabelText("SQL draft")).toHaveValue("");
+  });
+});
