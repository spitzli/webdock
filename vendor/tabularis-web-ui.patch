+import { render, screen, cleanup } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { Modal } from "../../src/components/ui/Modal";
+import { WorkspaceRootContext } from "../../src/contexts/WorkspaceRootContext";
+import { containsWorkspaceEvent } from "../../src/utils/workspace";
+import { createEmbeddedPlatform } from "../../src/embed/platform";
+import type { TabularisClient } from "../../src/api/client";
+
+afterEach(cleanup);
+describe("embedding host boundary", () => {
+  it("portals dialogs inside the workspace so scoped styles and theme apply", () => {
+    const root = document.createElement("div"); root.className = "tabularis-workspace"; document.body.append(root);
+    render(<WorkspaceRootContext.Provider value={root}><Modal isOpen onClose={() => {}}><div role="dialog">Scoped dialog</div></Modal></WorkspaceRootContext.Provider>);
+    expect(root.contains(screen.getByRole("dialog"))).toBe(true);
+    cleanup(); root.remove();
+  });
+  it("preserves the standalone portal target", () => {
+    render(<Modal isOpen onClose={() => {}}><div role="dialog">Desktop dialog</div></Modal>);
+    expect(document.body.contains(screen.getByRole("dialog"))).toBe(true);
+  });
+  it("ignores keyboard events from the surrounding host application", () => {
+    const root = document.createElement("div"), input = document.createElement("input"); root.append(input);
+    expect(containsWorkspaceEvent(root, input)).toBe(true);
+    expect(containsWorkspaceEvent(root, document.body)).toBe(false);
+    expect(containsWorkspaceEvent(null, document.body)).toBe(true);
+  });
+  it("does not open standalone application routes in the host", async () => {
+    const open = vi.spyOn(window, "open");
+    const platform = createEmbeddedPlatform({} as TabularisClient);
+    expect(platform.supports("openRoute")).toBe(false);
+    expect(platform.negotiation.capabilities.openRoute.supported).toBe(false);
+    await expect(platform.openRoute({ route: "/results-window", label: "results", title: "Results" })).rejects.toThrow();
+    expect(open).not.toHaveBeenCalled(); open.mockRestore();
+  });
+});
