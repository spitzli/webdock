@@ -0,0 +1,53 @@
+import { useCallback, useEffect, useMemo, useState, type ReactNode } from "react";
+import { createInstance } from "i18next";
+import { I18nextProvider } from "react-i18next";
+import en from "../i18n/locales/en.json";
+import de from "../i18n/locales/de.json";
+import { ThemeContext } from "../contexts/ThemeContext";
+import { SettingsContext, DEFAULT_SETTINGS, type Settings } from "../contexts/SettingsContext";
+import { DEFAULT_THEME_SETTINGS } from "../types/theme";
+import { builtinCatalog, selectEffectiveTheme } from "../utils/themeCatalog";
+import { applyThemeToCSS } from "../themes/themeUtils";
+import type { WorkspaceRuntimeProps } from "./types";
+
+async function hostManaged(): Promise<never> {
+  throw new Error("Appearance is managed by the host application");
+}
+
+/** Embedded preferences are ephemeral; host account settings are never changed. */
+export function WorkspaceAppearance({ children, root, locale = "en", theme = "light" }:
+  Pick<WorkspaceRuntimeProps, "root" | "locale" | "theme"> & { children: ReactNode }) {
+  const [i18n] = useState(() => {
+    const instance = createInstance();
+    void instance.init({ lng: locale, fallbackLng: "en", initAsync: false,
+      resources: { en: { translation: en }, de: { translation: de } }, interpolation: { escapeValue: false } });
+    return instance;
+  });
+  const [preferences, setPreferences] = useState(DEFAULT_SETTINGS);
+  const settings = useMemo(() => ({ ...preferences, language: locale, aiEnabled: false,
+    autoConnectLastConnection: false, showWelcome: false }), [preferences, locale]);
+  const updateSetting = useCallback(async <K extends keyof Settings>(key: K, value: Settings[K] | ((previous: Settings[K]) => Settings[K])) => {
+    setPreferences(previous => ({ ...previous, [key]: typeof value === "function" ? value(previous[key]) : value }));
+  }, []);
+  const [catalog] = useState(builtinCatalog);
+  const allThemes = useMemo(() => catalog.themes.map(entry => entry.resolved.theme), [catalog]);
+  const themeSettings = useMemo(() => ({ ...DEFAULT_THEME_SETTINGS, activeThemeId: `tabularis-${theme}`, followSystemTheme: false }), [theme]);
+  const selection = useMemo(() => selectEffectiveTheme(themeSettings, allThemes, theme === "dark"), [themeSettings, allThemes, theme]);
+  useEffect(() => { void i18n.changeLanguage(locale); }, [i18n, locale]);
+  useEffect(() => {
+    applyThemeToCSS(selection.theme, root);
+    root.style.setProperty("--font-size-base", "14px");
+  }, [root, selection.theme]);
+  const themeValue = useMemo(() => ({ currentTheme: selection.theme, settings: themeSettings,
+    allThemes, isLoading: false, catalog, selection, refreshCatalog: async () => catalog,
+    setTheme: hostManaged, createCustomTheme: hostManaged, updateCustomTheme: hostManaged,
+    deleteCustomTheme: hostManaged, duplicateTheme: hostManaged, importTheme: hostManaged,
+    exportTheme: hostManaged, updateSettings: hostManaged, updatePersonalSource: hostManaged,
+    previewTheme: () => {}, previewDefinition: () => {}, cancelPreview: () => {},
+  }), [selection, themeSettings, allThemes, catalog]);
+  return <I18nextProvider i18n={i18n}><ThemeContext.Provider value={themeValue}>
+    <SettingsContext.Provider value={{ settings, updateSetting, isLoading: false, isLanguageReady: true, isLanguageSettled: true }}>
+      {children}
+    </SettingsContext.Provider>
+  </ThemeContext.Provider></I18nextProvider>;
+}
