{
  "name": "webdock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/database-gateway",
    "apps/website",
    "apps/cms-instance",
    "packages/*",
    "modules/*",
    "adapters/*/*",
    "integrations/*",
    "extensions/*",
    "apps/console"
  ],
  "scripts": {
    "dev": "tilt up",
    "setup:admin": "cargo run --locked -p webdock-control-plane --bin webdock-bootstrap-operator --",
    "build": "cargo build --workspace --locked && bun run build:console",
    "build:web": "bun run --filter @webdock/web build",
    "lint": "bun run --filter \"*\" lint",
    "test": "bun run quality",
    "test:web": "bun run --filter @webdock/web test",
    "dev:auth": "bun run --filter @webdock/console dev:account",
    "test:auth": "cargo test --locked -p webdock-identity -p webdock-browser-session",
    "test:sso": "bun test ./packages/payload-sso/src/index.test.ts",
    "test:cms-ui": "bun test ./packages/cms-ui/src/server.test.ts ./packages/cms-ui/src/localization.test.tsx ./packages/cms-ui/src/uncertain-save.test.tsx",
    "test:cms-instance:acceptance": "python3 apps/cms-instance/scripts/acceptance.py",
    "test:cms-integration": "bun --env-file=legacy/console/.env.test.local test ./packages/cms-ui/src/integration.test.ts",
    "test:api": "cargo test --locked -p webdock-control-plane",
    "build:api": "cargo build --locked -p webdock-control-plane --bins",
    "test:modules": "bun tools/tests/modules.mjs",
    "test:distribution": "python3 tools/release/check-compose.py && python3 tools/release/check-charts.py && cargo test --locked -p webdock-control-plane --test probes",
    "test:plugin-jobs": "bun tools/plugins/test-jobs.mjs",
    "dev:console": "bun run --filter @webdock/console dev",
    "build:console": "bun run --filter @webdock/console build",
    "test:rust": "cargo test --workspace",
    "quality": "cargo run --manifest-path tools/quality/Cargo.toml --locked -- all",
    "quality:rust": "cargo run --manifest-path tools/quality/Cargo.toml --locked -- rust",
    "quality:frontend": "cargo run --manifest-path tools/quality/Cargo.toml --locked -- frontend",
    "quality:contracts": "cargo run --manifest-path tools/quality/Cargo.toml --locked -- contracts",
    "dev:web": "bun run --filter @webdock/web dev",
    "dev:api": "cargo run --locked -p webdock-control-plane"
  },
  "overrides": {
    "nodemailer": "10.0.13",
    "dompurify": "3.4.16"
  },
  "license": "AGPL-3.0-only"
}
