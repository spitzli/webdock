{
  "name": "webdock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run dev -w @webdock/web",
    "dev:admin": "npm run dev -w @webdock/admin",
    "build": "npm run build -w @webdock/web && npm run build -w @webdock/admin && npm run build -w @webdock/cms",
    "build:web": "npm run build -w @webdock/web",
    "build:admin": "npm run build -w @webdock/admin",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test -w @webdock/admin",
    "test:web": "npm run test -w @webdock/web"
  },
  "overrides": {
    "nodemailer": "10.0.13"
  }
}
