{
  "name": "webdock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/auth",
    "apps/console",
    "apps/control-plane",
    "apps/database-gateway",
    "apps/mail",
    "apps/website",
    "apps/cms-instance",
    "packages/*",
    "modules/*",
    "adapters/*/*",
    "integrations/*",
    "extensions/*",
    "apps/console-ui"
  ],
  "scripts": {
    "dev": "bun run --filter @webdock/web dev",
    "setup:admin": "bun --no-env-file tools/migrations/operator-setup-cli.ts",
    "dev:admin": "bun run --filter @webdock/admin dev",
    "build": "bun run --filter @webdock/web build && bun run --filter @webdock/admin build && bun run --filter @webdock/auth build",
    "build:web": "bun run --filter @webdock/web build",
    "build:admin": "bun run --filter @webdock/admin build",
    "lint": "bun run --filter \"*\" lint",
    "test": "bun run --filter @webdock/admin test",
    "test:web": "bun run --filter @webdock/web test",
    "dev:auth": "bun run --filter @webdock/auth dev",
    "build:auth": "bun run --filter @webdock/auth build",
    "test:auth": "bun run --filter @webdock/auth test",
    "test:sso": "bun test ./packages/payload-sso/src/index.test.ts",
    "test:cms-ui": "bun test ./packages/cms-ui/src/server.test.ts ./packages/cms-ui/src/localization.test.tsx ./packages/cms-ui/src/uncertain-save.test.tsx",
    "test:cms-instance:acceptance": "python3 apps/cms-instance/scripts/acceptance.py",
    "test:cms-integration": "bun --env-file=apps/console/.env.test.local test ./packages/cms-ui/src/integration.test.ts",
    "test:api": "bun run --filter @webdock/api test",
    "build:api": "bun run --filter @webdock/api build",
    "test:modules": "bun tools/tests/modules.mjs",
    "test:distribution": "bun test ./tools/release/manifest.test.mjs && python3 tools/release/check-charts.py",
    "test:plugin-jobs": "bun tools/plugins/test-jobs.mjs",
    "build:core": "bun run --filter @webdock/api build:core",
    "test:core-boundary": "bun tools/tests/core-product-free.mjs && bun tools/tests/core-routes-artifact.mjs",
    "build:core:console": "bun tools/release/build-core-console.mjs",
    "dev:console-ui": "bun run --filter @webdock/console-ui dev",
    "build:console-ui": "bun run --filter @webdock/console-ui build",
    "test:rust": "cargo test --workspace",
    "quality": "cargo run --manifest-path tools/quality/Cargo.toml --locked -- all",
    "quality:rust": "cargo run --manifest-path tools/quality/Cargo.toml --locked -- rust",
    "quality:frontend": "cargo run --manifest-path tools/quality/Cargo.toml --locked -- frontend",
    "quality:contracts": "cargo run --manifest-path tools/quality/Cargo.toml --locked -- contracts"
  },
  "overrides": {
    "nodemailer": "10.0.13",
    "dompurify": "3.4.16"
  },
  "license": "AGPL-3.0-only"
}
