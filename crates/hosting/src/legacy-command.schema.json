          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483646
        },
        "capacity": {
          "type": "object",
          "properties": {
            "apps": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
