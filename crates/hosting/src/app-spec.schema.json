{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "template": {
      "type": "string",
      "enum": [
        "healthcheck",
        "custom"
      ]
    },
    "image": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[a-zA-Z0-9.-]+(?::[0-9]+)?\\/[a-zA-Z0-9_./-]+@sha256:[a-f0-9]{64}$"
    },
    "args": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "healthPath": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^\\/[a-zA-Z0-9/_-]*$"
    },
    "cpuMillicores": {
      "type": "integer",
      "minimum": 10,
      "maximum": 64000
    },
    "memoryBytes": {
      "type": "integer",
      "minimum": 16777216,
      "maximum": 1099511627776
    },
    "ephemeralBytes": {
      "type": "integer",
      "minimum": 1048576,
      "maximum": 1099511627776
    },
    "replicas": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "volumeBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1099511627776
    }
  },
  "required": [
    "template",
    "image",
    "args",
    "port",
    "healthPath",
    "cpuMillicores",
    "memoryBytes",
    "ephemeralBytes",
    "replicas"
  ],
  "additionalProperties": false
}
