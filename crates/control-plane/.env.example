# Runtime uses a dedicated authentication pool and a separate registry pool.
# Never use database owners, superusers or migration credentials here.
NODE_ENV=development
WEBDOCK_DATABASE_URL=postgresql://webdock_auth_bootstrap:CHANGE_ME@127.0.0.1:5432/webdock
WEBDOCK_REGISTRY_DATABASE_URL=postgresql://webdock_registry_runtime:CHANGE_ME@127.0.0.1:5432/webdock
WEBDOCK_AUTH_SECRET=REPLACE_WITH_A_PRIVATE_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
DATABASE_RLS_SECRET=REPLACE_WITH_THE_EXISTING_PRIVATE_DATABASE_CONTEXT_KEY
WEBDOCK_API_ORIGIN=http://127.0.0.1:3130
WEBDOCK_AUTH_ORIGIN=http://localhost:3125
WEBDOCK_STUDIO_ORIGIN=http://127.0.0.1:3120
WEBDOCK_CONSOLE_ORIGIN=http://127.0.0.1:3121
WEBDOCK_FEATURES={}
WEBDOCK_BIND_ADDRESS=127.0.0.1
PORT=3130

# Required for account access and hosting; a distinct restricted business pool.
WEBDOCK_SESSION_DATABASE_URL=postgresql://webdock_auth_runtime:CHANGE_ME@127.0.0.1:5432/webdock
# WEBDOCK_WORKER_DATABASE_URL=postgresql://webdock_worker_runtime:CHANGE_ME@127.0.0.1:5432/webdock
# Set this to the previous BETTER_AUTH_SECRET when rotating the identity secret.
# It preserves existing application environment encryption, not native Mail encryption.
# WEBDOCK_HOSTING_ENCRYPTION_KEY=RETAIN_THE_EXISTING_SECRET
# Retain these registered protocol identifiers at migration; never silently register new clients.
# WEBDOCK_MCP_RESOURCE=https://studio.webdock.dev/api/mcp
# WEBDOCK_STUDIO_CLIENT_ID=EXISTING_REGISTERED_CLIENT_ID
# Native Registry/Hosting/MCP bearer resources, independent of installed plugins.
# Existing confidential client must be linked to the retained MCP resource.
# WEBDOCK_RESOURCE_CLIENT_ID=EXISTING_RESOURCE_INTROSPECTION_CLIENT_ID
# WEBDOCK_RESOURCE_CLIENT_SECRET_FILE=/run/secrets/webdock-resource-client

# Optional first-party Console SSO facade: use the retained offline-registered Portal client.
# Register each exact Console/Studio origin + /api/sso/callback; never use an organization client.
# WEBDOCK_SSO_CLIENT_ID=EXISTING_REGISTERED_CLIENT_ID
# WEBDOCK_SSO_CLIENT_SECRET=EXISTING_REGISTERED_CLIENT_SECRET
# WEBDOCK_SSO_COOKIE_SECRET=RETAIN_THE_EXISTING_PRIVATE_SSO_COOKIE_SECRET
# Optional explicit Unix-seconds deadline, no more than eight hours ahead when enabling transition.
# WEBDOCK_SSO_LEGACY_ACCEPT_UNTIL=REVIEWED_CUTOVER_DEADLINE

# Production static React artifact; run `bun run build:console` first.
# WEBDOCK_UI_DIST=/opt/webdock/ui
# Exact HTTPS origins allowed for declared isolated plugin frames / database gateway fetches.
# WEBDOCK_UI_FRAME_ORIGINS=["https://plugins.example.invalid"]
# WEBDOCK_UI_CONNECT_ORIGINS=["https://database.example.invalid"]

# Optional native database viewer; enable databases only after its offline migration/install.
# WEBDOCK_DATABASE_GATEWAY_ORIGIN=https://database-gateway.example.com
# WEBDOCK_DATABASE_GATEWAY_SECRET=RETAIN_THE_PRIVATE_GATEWAY_SECRET
# Add that exact origin to WEBDOCK_UI_CONNECT_ORIGINS; its WS/WSS counterpart is derived.

# Optional native mailbox viewer; outgoing-only Mail does not activate/provision mailboxes.
# Incoming administration is separate from the viewer and still requires explicit tenant activation.
# WEBDOCK_NATIVE_MAIL_ENABLED=true
# WEBDOCK_NATIVE_MAILBOXES_ENABLED=true
# MAIL_GATEWAY_ORIGIN=https://mail-gateway.example.com
# Add that exact origin to WEBDOCK_UI_CONNECT_ORIGINS; the Console calls the gateway directly.
# MAIL_GATEWAY_SECRET=RETAIN_THE_PRIVATE_MAIL_GATEWAY_SECRET
# MAIL_MANAGED_CLUSTER_ID=EXISTING_MANAGED_CLUSTER_ID
# MAIL_ENCRYPTION_KEY=RETAIN_THE_EXISTING_BASE64_32_BYTE_MAIL_KEY
# MAIL_HOSTNAME_SUFFIX=mail.example.invalid
# Optional incoming execution on the separately supervised agent-control listener.
# Requires native Mail administration, the Mail feature and explicitly enrolled capable agents.
# WEBDOCK_NATIVE_MAIL_AGENT_ENABLED=true
# Optional domain/mailbox/access configuration execution; lifecycle alone never enables it.
# Requires all three native Mail administration, agent and mailbox flags above.
# The enrolled agent separately opts in with mailConfigurationEnabled in its private JSON config.
# WEBDOCK_NATIVE_MAIL_CONFIGURATION_ENABLED=true
# Build infra/mail/Dockerfile and use its reviewed immutable registry digest.
# MAIL_STALWART_IMAGE=registry.example.invalid/webdock/mail@sha256:REVIEWED_RESTRICTED_IMAGE_DIGEST
# Reuse MAIL_MANAGED_CLUSTER_ID, MAIL_HOSTNAME_SUFFIX and the retained MAIL_ENCRYPTION_KEY.
# Core does not receive Docker sockets or Kubernetes credentials.

# Optional native outgoing API/worker, independent of incoming mailbox provisioning.
# WEBDOCK_NATIVE_MAIL_SENDING_ENABLED=true
# MAIL_SEND_WORKER_SECRET=SEPARATE_PRIVATE_WORKER_SECRET_OF_AT_LEAST_32_CHARACTERS
# WEBDOCK_NATIVE_PLUGIN_CONFIG=/etc/webdock/plugins/private.json
# The private plugin config's mail entry supplies signingKey, workerId and workerGeneration.
# The HTTP process and webdock-plugin-control must use the same reviewed Mail configuration.
