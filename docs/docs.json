{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Webdock",
  "description": "Product guides and developer documentation for Webdock Console, hosting, websites and Mail.",
  "colors": {
    "primary": "#B84F18",
    "light": "#FF9255",
    "dark": "#D96529"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "guides/console",
              "guides/access"
            ]
          },
          {
            "group": "Products",
            "pages": [
              "guides/websites",
              "guides/applications",
              "guides/project-setup",
              "guides/storage",
              "guides/databases",
              "guides/mail",
              "guides/plans-and-billing"
            ]
          },
          {
            "group": "Your infrastructure (BYOK)",
            "pages": [
              "guides/byok",
              "guides/byok-kubernetes",
              "guides/byok-vercel",
              "guides/byok-mail"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "guides/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Developers",
        "groups": [
          {
            "group": "Integrations",
            "pages": [
              "developers/overview",
              "developers/authentication",
              "developers/mcp",
              "developers/byok",
              "developers/registry",
              "developers/website-integration"
            ]
          },
          {
            "group": "Mail",
            "pages": [
              "developers/mail-quickstart",
              "developers/mail-api",
              "developers/mail-webhooks"
            ]
          },
          {
            "group": "Plugins",
            "pages": [
              "developers/plugins",
              "developers/managed-apps",
              "developers/managed-analytics",
              "developers/project-notes",
              "developers/plugin-manifest",
              "developers/plugin-api-mcp",
              "developers/plugin-jobs",
              "developers/managed-registry"
            ]
          },
          {
            "group": "Operate Webdock",
            "pages": [
              "developers/self-hosting",
              "developers/core-distribution",
              "developers/initial-setup",
              "developers/modules",
              "developers/auth-adapters"
            ]
          },
          {
            "group": "Contribute",
            "pages": [
              "developers/local-development",
              "developers/documentation"
            ]
          }
        ]
      },
      {
        "tab": "Mail API reference",
        "groups": [
          {
            "group": "Mail API",
            "openapi": "/openapi/mail.json"
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://webdock.dev"
      },
      {
        "label": "Source",
        "href": "https://github.com/spitzli/webdock"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Console",
      "href": "https://console.webdock.dev"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/spitzli/webdock"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp"
    ]
  },
  "api": {
    "playground": {
      "display": "none"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ]
    }
