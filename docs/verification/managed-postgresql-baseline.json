  "admissionPolicies": [
    {
      "name": "webdock-application-safety",
      "spec": {
        "failurePolicy": "Fail",
        "matchConstraints": {
          "matchPolicy": "Equivalent",
          "namespaceSelector": {
            "matchExpressions": [
              {
                "key": "kubernetes.io/metadata.name",
                "operator": "NotIn",
                "values": [
                  "kube-system",
                  "cert-manager"
                ]
              }
            ]
          },
          "objectSelector": {},
          "resourceRules": [
            {
              "apiGroups": [
                ""
              ],
              "apiVersions": [
                "v1"
              ],
              "operations": [
                "CREATE",
                "UPDATE"
              ],
              "resources": [
                "pods",
                "pods/ephemeralcontainers"
              ],
              "scope": "*"
            }
          ]
        },
        "validations": [
          {
            "expression": "has(namespaceObject.metadata.labels) && 'security.webdock.dev/ready' in namespaceObject.metadata.labels && namespaceObject.metadata.labels['security.webdock.dev/ready'] == 'true' && 'pod-security.kubernetes.io/enforce' in namespaceObject.metadata.labels && namespaceObject.metadata.labels['pod-security.kubernetes.io/enforce'] == 'restricted'",
            "message": "Webdock: namespace requires resource quotas, network policies and Restricted Pod Security before workloads can start."
          },
          {
            "expression": "has(object.spec.automountServiceAccountToken) && object.spec.automountServiceAccountToken == false",
            "message": "Webdock: automatic API token mounting must be explicitly disabled."
          },
          {
            "expression": "!has(object.spec.volumes) || object.spec.volumes.all(v,\n  !has(v.projected) || v.projected.sources.all(s, !has(s.serviceAccountToken)))",
            "message": "Webdock: application pods must not request projected API tokens."
          },
          {
            "expression": "object.spec.containers.all(c,\n  has(c.securityContext) && has(c.securityContext.readOnlyRootFilesystem) && c.securityContext.readOnlyRootFilesystem) &&\n(!has(object.spec.initContainers) || object.spec.initContainers.all(c,\n  has(c.securityContext) && has(c.securityContext.readOnlyRootFilesystem) && c.securityContext.readOnlyRootFilesystem)) &&\n(!has(object.spec.ephemeralContainers) || object.spec.ephemeralContainers.all(c,\n  has(c.securityContext) && has(c.securityContext.readOnlyRootFilesystem) && c.securityContext.readOnlyRootFilesystem))",
            "message": "Webdock: every application, init and debug container requires a read-only root filesystem; use explicit volumes for writable data."
          },
          {
            "expression": "object.spec.containers.all(c, has(c.resources) && has(dyn(c.resources).requests) && has(dyn(c.resources).limits) &&\n  ['cpu', 'memory', 'ephemeral-storage'].all(r, r in dyn(c.resources).requests && r in dyn(c.resources).limits &&\n    quantity(dyn(c.resources).requests[r]).isGreaterThan(quantity(\"0\")) &&\n    quantity(dyn(c.resources).limits[r]).isGreaterThan(quantity(\"0\")))) &&\n(!has(object.spec.initContainers) || object.spec.initContainers.all(c,\n  has(c.resources) && has(dyn(c.resources).requests) && has(dyn(c.resources).limits) &&\n  ['cpu', 'memory', 'ephemeral-storage'].all(r, r in dyn(c.resources).requests && r in dyn(c.resources).limits &&\n    quantity(dyn(c.resources).requests[r]).isGreaterThan(quantity(\"0\")) &&\n    quantity(dyn(c.resources).limits[r]).isGreaterThan(quantity(\"0\")))))",
            "message": "Webdock: CPU, memory and ephemeral-storage requests and limits are required."
          },
          {
            "expression": "object.spec.restartPolicy != 'Always' || object.spec.containers.all(c,\n  has(c.readinessProbe) && has(c.livenessProbe) && has(c.startupProbe))",
            "message": "Webdock: long-running application containers require readiness, liveness and startup probes."
          }
        ]
      }
    },
    {
      "name": "webdock-service-safety",
      "spec": {
        "failurePolicy": "Fail",
        "matchConstraints": {
          "matchPolicy": "Equivalent",
          "namespaceSelector": {
            "matchExpressions": [
              {
                "key": "kubernetes.io/metadata.name",
                "operator": "NotIn",
                "values": [
                  "kube-system"
                ]
              }
            ]
          },
          "objectSelector": {},
          "resourceRules": [
            {
              "apiGroups": [
                ""
              ],
              "apiVersions": [
                "v1"
              ],
              "operations": [
                "CREATE",
                "UPDATE"
              ],
              "resources": [
                "services"
              ],
              "scope": "*"
            }
          ]
        },
        "validations": [
          {
            "expression": "object.spec.type == 'ClusterIP' && (!has(object.spec.externalIPs) || size(object.spec.externalIPs) == 0)",
            "message": "Webdock: applications expose ClusterIP services through managed ingress only; external IPs, ExternalName, NodePort and LoadBalancer are forbidden."
          }
        ]
      }
    }
