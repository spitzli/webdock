{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "image",
    "existingSecret",
    "existingClaim",
    "namespaces",
    "resources",
    "egress"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "image": {
      "type": "string"
    },
    "existingSecret": {
      "type": "string"
    },
    "existingClaim": {
      "type": "string"
    },
    "namespaces": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "not": {
          "enum": [
            "kube-system",
            "kube-public",
            "kube-node-lease",
            "webdock-agent"
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ]
    },
    "egress": {
      "type": "array"
    }
  },
  "if": {
    "properties": {
      "enabled": {
        "const": true
      }
    }
  },
  "then": {
    "properties": {
      "image": {
        "pattern": "^.+@sha256:[a-f0-9]{64}$"
      },
      "existingSecret": {
        "minLength": 1
      },
      "existingClaim": {
        "minLength": 1
      },
      "namespaces": {
        "minItems": 1
      }
    }
  }
}
