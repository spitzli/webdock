{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "existingSecret", "locationEvidence", "s3", "objectStoreCIDRs", "clientNamespaceSelector", "clientPodSelector", "resources"],
  "properties": {
    "image": {"type": "string", "pattern": "^[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64}$"},
    "existingSecret": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"},
    "locationEvidence": {"type": "string", "minLength": 20, "maxLength": 1000},
    "s3": {
      "type": "object", "additionalProperties": false,
      "required": ["endpoint", "region", "bucket", "port"],
      "properties": {
        "endpoint": {"type": "string", "pattern": "^https://[a-zA-Z0-9.-]+(:[0-9]{1,5})?/?$", "maxLength": 253},
        "region": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
        "bucket": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "objectStoreCIDRs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/(1[6-9]|2[0-9]|3[0-2])$"}},
    "clientNamespaceSelector": {"type": "object", "minProperties": 1, "maxProperties": 16, "additionalProperties": {"type": "string", "minLength": 1}},
    "clientPodSelector": {"type": "object", "minProperties": 1, "maxProperties": 16, "additionalProperties": {"type": "string", "minLength": 1}},
    "resources": {
      "type": "object", "required": ["requests", "limits"], "additionalProperties": false,
      "properties": {
        "requests": {"type": "object", "required": ["cpu", "memory"], "additionalProperties": false, "properties": {"cpu": {"type": "string", "minLength": 1}, "memory": {"type": "string", "minLength": 1}}},
        "limits": {"type": "object", "required": ["cpu", "memory"], "additionalProperties": false, "properties": {"cpu": {"type": "string", "minLength": 1}, "memory": {"type": "string", "minLength": 1}}}
      }
    }
  }
}
