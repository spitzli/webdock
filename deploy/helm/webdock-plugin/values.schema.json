{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "image",
    "labels",
    "revision",
    "generation",
    "specHash",
    "arguments",
    "replicas",
    "port",
    "ephemeralBytes",
    "resources",
    "volume"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^wd-[a-z][a-z0-9-]{0,23}-[1-9][0-9]{0,18}$",
      "maxLength": 63
    },
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+(:[0-9]{1,5})?/[a-z0-9_./-]+@sha256:[a-f0-9]{64}$",
      "maxLength": 512
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "webdock.dev/managed-by",
        "webdock.dev/installation",
        "webdock.dev/project-id",
        "webdock.dev/resource-id"
      ],
      "properties": {
        "webdock.dev/managed-by": {
          "const": "webdock"
        },
        "webdock.dev/installation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,23}$"
        },
        "webdock.dev/project-id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "webdock.dev/resource-id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "specHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "arguments": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "replicas": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "healthPath": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^/[A-Za-z0-9/_-]*$",
      "maxLength": 160
    },
    "ephemeralBytes": {
      "type": "integer",
      "minimum": 1048576,
      "maximum": 1099511627776
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "$ref": "#/definitions/resources"
        },
        "limits": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "sizeBytes"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "sizeBytes": {
            "minimum": 67108864
          }
        }
      }
    },
    "plugin": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "manifestSha256",
        "pluginId",
        "version",
        "runtimeGeneration"
      ],
      "properties": {
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pluginId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "runtimeGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "mounts": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "secretName"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "secretName": {
            "type": "string",
            "pattern": "^wd-secret-[1-9][0-9]{0,18}-[a-z][a-z0-9-]{0,31}$",
            "maxLength": 63
          }
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
      }
    }
  },
  "definitions": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory",
        "ephemeral-storage"
      ],
      "properties": {
        "cpu": {
          "type": "string",
          "pattern": "^[1-9][0-9]*m$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "ephemeral-storage": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    }
  }
}
