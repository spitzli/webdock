  "jobs": [],
  "offerings": [
    {
      "id": "domain",
      "label": "Sending domain",
      "description": "A domain you send mail from. Add it, prove you own it with one DNS record, then send from any address at that domain.",
      "highlights": [
        "Needed before sending or creating mailboxes",
        "Shows every DNS record to add at your DNS provider",
        "Send from the console, the API or the send_email MCP tool",
        "Keeps a log of recent messages"
      ]
    },
    {
      "id": "relay",
      "label": "Own turboSMTP account",
      "description": "Your own turboSMTP account for sending, instead of the platform's. Useful if you already have a turboSMTP contract, sending volume or reputation.",
      "highlights": [
        "All mail of the project goes through your account",
        "Keys are stored encrypted and never shown again",
        "Uses the turboSMTP EU endpoint",
        "Remove it any time to send through the platform again"
      ]
    },
    {
      "id": "mailbox",
      "label": "Mailbox",
      "description": "An inbox at one of your domains, for a person or a team. Read and write it with any mail app over IMAP and SMTP.",
      "highlights": [
        "Address at your own domain, such as hello@example.com",
        "Works with Outlook, Apple Mail, Thunderbird and phones",
        "Password shown on request and rotatable",
        "1 GB of storage"
      ]
    }
  ],
  "selfService": {
    "features": [
      {
        "id": "add-domains",
        "label": "Add sending domains",
        "offering": "domain",
        "description": "Add and remove domains to send mail from"
      },
      {
        "id": "byok-turbosmtp",
        "label": "Connect own turboSMTP account",
        "offering": "relay",
        "description": "Send through the customer's own turboSMTP account instead of the platform's"
      },
      {
        "id": "create-mailboxes",
        "label": "Create mailboxes",
        "offering": "mailbox",
        "description": "Create and remove mailboxes on the project's domains"
      },
      {
        "id": "manage-incoming",
        "label": "Manage incoming mail",
        "offering": "domain",
        "description": "Activate or suspend incoming mail for all projects of the customer; suspension retains mailbox data"
      }
    ]
  },
  "areas": {
    "operator": {
      "pages": []
    },
    "selfService": {
      "pages": [
        {
          "id": "resource",
          "label": "Mail",
          "action": "domains.view",
          "resource": true
        }
      ]
    }
  },
  "events": [],
  "secrets": [],
  "httpBindings": [],
  "api": [
    {
      "method": "POST",
      "path": "/send",
      "action": "mail.send"
    },
    {
      "method": "POST",
      "path": "/status",
      "action": "mail.status"
    },
    {
      "method": "POST",
      "path": "/cancel",
      "action": "mail.cancel"
    },
    {
      "method": "POST",
      "path": "/history",
      "action": "mail.history"
    }
  ],
  "mcp": [
    {
      "name": "send_email",
      "description": "Send a plain-text email from a verified sending domain of the project",
      "action": "mail.send"
    },
    {
      "name": "email_status",
      "action": "mail.status",
      "description": "Get the durable status of a message on an owned sending domain"
    },
    {
      "name": "cancel_email",
      "action": "mail.cancel",
      "description": "Cancel a message before handoff on an owned sending domain"
    },
    {
      "name": "email_history",
      "action": "mail.history",
      "description": "List the latest twenty durable sends on an owned sending domain"
    }
  ]
}
