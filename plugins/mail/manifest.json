    },
    {
      "name": "mail.send",
      "intent": "write",
      "audience": "customer",
      "capabilities": [],
      "resource": "use",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id",
          "from",
          "to",
          "subject",
          "text"
        ],
        "properties": {
          "resource_id": {
            "type": "string",
            "maxLength": 128,
            "description": "Sending domain"
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Sender name before the @"
          },
          "from_name": {
            "type": "string",
            "maxLength": 80,
            "description": "Sender display name"
          },
          "to": {
            "type": "string",
            "minLength": 3,
            "maxLength": 2000,
            "description": "Recipients, comma-separated"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Subject"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000,
            "description": "Plain-text body"
          }
        }
      }
    },
    {
      "name": "mail.status",
