!crates/plugin-kit/src/**/*.rs
!crates/plugin-protocol/
crates/plugin-protocol/**
!crates/plugin-protocol/Cargo.toml
!crates/plugin-protocol/src/
crates/plugin-protocol/src/**
!crates/plugin-protocol/src/**/*.rs
!crates/plugin-runtime/
crates/plugin-runtime/**
!crates/plugin-runtime/Cargo.toml
!crates/plugin-runtime/build.rs
!crates/plugin-runtime/src/
crates/plugin-runtime/src/**
!crates/plugin-runtime/src/**/*.rs
!proto/
proto/**
!proto/webdock/
proto/webdock/**
!proto/webdock/plugin/
proto/webdock/plugin/**
!proto/webdock/plugin/v1/
proto/webdock/plugin/v1/**
!plugins/
plugins/**
!plugins/object-storage/
