!plugins/object-storage/Cargo.toml
!plugins/object-storage/Cargo.lock
!plugins/object-storage/manifest.json
!plugins/object-storage/src/
plugins/object-storage/src/**
!plugins/object-storage/src/**/*.rs
!plugins/object-storage/migrations/
plugins/object-storage/migrations/**
!plugins/object-storage/migrations/*.sql
**/.env*
**/*secret*
**/target/**
**/.private/**
**/*.pem
**/*.key
