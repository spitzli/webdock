[Unit]
Description=Webdock local persistent storage helper
After=local-fs.target
Before=k3s.service webdock-hosting-agent.service

[Service]
Type=notify
NotifyAccess=main
User=root
Group=root
WorkingDirectory=/opt/webdock-hosting-agent
ExecStart=/usr/bin/python3 /opt/webdock-hosting-agent/storage_service.py
Restart=on-failure
RestartSec=15
UMask=0077
RuntimeDirectory=webdock-storage
RuntimeDirectoryMode=0700
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
# Mounts must be in the host namespace, visible to kubelet. Filesystem namespace
# sandbox options belong to the unprivileged agent, not this private helper.
PrivateMounts=false
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
